re.bootstrap_sha256 = hashlib.sha256(sys.orig_argv[sys.orig_argv.index('-c') + 1].encode('utf-8')).hexdigest()\nsys.modules[closure.__name__] = closure\n\nclass Sources(importlib.abc.MetaPathFinder, importlib.abc.Loader):\n    def find_spec(self, fullname, path=None, target=None):\n        if fullname in sources:\n            return importlib.util.spec_from_loader(fullname, self)\n        return None\n\n    def create_module(self, spec):\n        return None\n\n    def exec_module(self, module):\n        name = module.__name__\n        module.__file__ = str(logical / (name + '.py'))\n        closure.compiled.append(name)\n        exec(compile(sources[name], module.__file__, 'exec'), module.__dict__)\n\nif any(os.path.normcase(str(root)) == os.path.normcase(str(Path(value or '.').absolute())) or os.path.normcase(str(logical)) == os.path.normcase(str(Path(value or '.').absolute())) for value in sys.path):\n    raise ValueError('BENCH_SEARCH_PATH')\nsys.meta_path.insert(0, Sources())\nsys.argv = [str(logical / (entry + '.py')), *arguments]\nif entry == '--inspect':\n    for name in ('runtime_guard', 'evidence', 'fixtures', 'prototype'):\n        __import__(name)\n    print(json.dumps({'sha256': closure.sha256, 'compiled': closure.compiled,\n                      'bootstrap_sha256': closure.bootstrap_sha256, 'source_only': True}))\nelse:\n    if entry not in sources:\n        raise ValueError('BENCH_ENTRY')\n    module = types.ModuleType('__main__')\n    module.__file__ = sys.argv[0]\n    sys.modules['__main__'] = module\n    closure.compiled.append(entry)\n    exec(compile(sources[entry], module.__file__, 'exec'), module.__dict__)\r\n", "C:\\Sources\\madness\\_bmad-output\\initiative-madness\\tickets\\epic-projets-bmad\\qualification-profil-g2", "C:\\Sources\\madness\\_bmad-output\\initiative-madness\\tickets\\epic-projets-bmad\\qualification-profil-g2", "{\"prototype\": \"0ba95cd9838506b48994e7c67a00e2a9095204dfebf03f3cc350086df2d867ba\", \"fixtures\": \"58e6d6407a65f