+
+test('an expired microtask never dispatches a page read',async t=>{
+ let now=performance.now(),calls=0
+ t.mock.method(performance,'now',()=>now)
+ try{
+  const waiting=waitForPageCondition({evaluate:async()=>{calls++;return false}},()=>false,undefined,{timeout:5,interval:1})
+  now+=35
+  await assert.rejects(waiting,{name:'TimeoutError'})
+  assert.equal(calls,0,'an evaluation must not begin after its absolute deadline')
+ }finally{t.mock.restoreAll()}
+})
