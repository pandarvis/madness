{
  "name": "madness",
  "version": "0.2.27",
  "private": true,
  "description": "Espace de travail local BMad pour Windows — socle G0",
  "author": "Madness",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/*.test.mjs scripts/qualification/codex.test.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --win --x64 --dir --publish never",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "release:win": "npm run build && electron-builder --win --x64 --publish always",
    "qualify:windows": "node scripts/qualification/windows.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/fetch-runtime-bundle.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "jose": "6.2.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vis-data": "^8.0.6",
    "vis-network": "10.1.5",
    "vite": "8.3.7"
  }
}
