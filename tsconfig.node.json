{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["electron.vite.config.ts", "src/contracts/**/*.ts", "src/core/**/*.ts", "src/adapters/**/*.ts", "src/main/**/*.ts", "src/preload/**/*.ts"]
}
